{
  "name": "realstate-website",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm css:build && vite",
    "start": "pnpm dlx serve src -p 3000",
    "build": "pnpm importmap:build && vite build",
    "importmap:build": "rm -rf .generated/importmap && tsc -p tsconfig.importmap.json && node .generated/importmap/buildImportmap.js && rm -rf .generated/importmap",
    "css:build": "rm -f src/output.css && pnpm build && mv src/dist/output.css src/output.css && rm -rf src/dist",
    "check": "pnpm typecheck && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "node -e \"if(require('fs').existsSync('.git/hooks')){require('fs').chmodSync('.git/hooks/pre-commit', '755')}\""
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.18",
    "embla-carousel-react": "8.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.1",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.2.3",
    "jsdom": "28.1.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
